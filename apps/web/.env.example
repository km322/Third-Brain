NEXT_PUBLIC_API_URL=http://localhost:8000

# Deployment environment shown as the dashboard mode badge (development/test/staging/preview;
# blank or production hides it). NEXT_PUBLIC_APP_VERSION is not set here: it is derived from
# package.json at build time, never by hand.
NEXT_PUBLIC_APP_ENV=

# --- Waitlist bot protection (Cloudflare Turnstile) ---
# Public site key for the Turnstile widget on the waitlist form. Leave blank to disable
# the widget (dev). The matching secret key goes on the API as TURNSTILE_SECRET_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Waitlist email notification (EmailJS, client-side) ---
# Reuse an existing EmailJS service to be notified of signups. Leave blank to skip email
# (signups are still persisted by the API regardless). WAITLIST_TEMPLATE_ID is optional and
# falls back to TEMPLATE_ID. All three of SERVICE_ID/TEMPLATE_ID/PUBLIC_KEY are required to
# enable notifications.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_WAITLIST_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
