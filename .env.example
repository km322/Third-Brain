# ============================================================================
# Third Brain - environment configuration
# Copy to `.env`:  cp .env.example .env        (never commit `.env`)
#
# QUICK START: the defaults below run the whole stack locally with `make up` using an
# OFFLINE stub model - you don't need to change anything to try it. For REAL answers,
# set OPENAI_API_KEY. For PRODUCTION you MUST set a strong SECRET_KEY (and deploy domains).
# ============================================================================

# ---- Core ----
ENVIRONMENT=development                 # development | staging | production
LOG_LEVEL=INFO
# REQUIRED IN PRODUCTION: a long random secret, e.g. `openssl rand -hex 32`.
# Boot is refused in production while this is a placeholder or shorter than 32 chars.
SECRET_KEY=change-me-to-a-long-random-string-please
# Browser origins allowed to call the API (comma-separated).
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Public origin of the WEB app (the dashboard). Invite accept links, the CLI device-auth
# /activate URL and the default SSO redirect_uri are built from this, so production MUST
# set the real origin, e.g. APP_BASE_URL=https://your-domain.example
APP_BASE_URL=http://localhost:3000

# ---- Database (Postgres + pgvector) - defaults match docker-compose ----
POSTGRES_USER=thirdbrain
POSTGRES_PASSWORD=thirdbrain
POSTGRES_DB=thirdbrain
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Or set a full async URL directly (e.g. managed Postgres). MUST use the +asyncpg driver:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
# Connection pool tuning (worth setting explicitly in production; see docs/DEPLOYMENT.md).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# SQL_ECHO=false                          # true logs every SQL statement (noisy; debug only)

# ---- Redis - default matches docker-compose ----
REDIS_URL=redis://redis:6379/0

# ---- Auth / JWT ----
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ---- LLM providers ----
# Leave every key blank to run FULLY OFFLINE - a deterministic stub is used for
# embeddings + answers (fine for local dev, NOT for production). Set any one key for real
# answers. Completion fallback priority: OpenAI -> Anthropic -> Google -> offline;
# embedding priority: OpenAI -> Google -> offline (Anthropic has no embeddings API).
# Per-org overrides live in the Connectors page.
# OPENAI_BASE_URL can point at OpenAI, Azure OpenAI, Ollama (http://localhost:11434/v1),
# vLLM, or any OpenAI-compatible gateway.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic (Claude, chat only). Uses the platform base URL unless overridden.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Google Gemini (chat + embeddings).
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# ---- Embeddings / retrieval ----
# EMBEDDING_MODEL and EMBEDDING_DIM MUST match (text-embedding-3-small = 1536).
# Changing the dimension requires re-indexing. Set EMBEDDING_PROVIDER=fake to force the
# offline stub even when a key is present.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
DEFAULT_COMPLETION_MODEL=gpt-4o-mini
# Public origin of THIS API. Baked into image documents' capability links (the URL an
# LLM fetches to view the original image), so production MUST set the real origin,
# e.g. PUBLIC_API_URL=https://api.your-domain.example
PUBLIC_API_URL=http://localhost:8000

# How the entity index (dashboard > Entities) is built:
#   llm       - ask the org's completion model (best quality; one small metered call per
#               document at ingestion). Falls back to `heuristic` automatically whenever no
#               billable provider is configured, so a keyless deploy behaves the same.
#   heuristic - deterministic, offline, zero provider cost.
ENTITY_EXTRACTION_MODE=llm
# Set to false to skip entity extraction entirely; the dashboard Entities page then stays
# empty for newly ingested documents.
# ENTITY_EXTRACTION_ENABLED=true
# Caps the text sent to the extractor per document - the knob that bounds the per-document
# cost of ENTITY_EXTRACTION_MODE=llm.
# ENTITY_EXTRACTION_MAX_CHARS=20000

CHUNK_SIZE_TOKENS=1024
CHUNK_TARGET_TOKENS=768
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_TOP_K=8
# How long (seconds) a query embedding stays cached in Redis (default 1 day).
# EMBED_CACHE_TTL_SECONDS=86400

# ---- Web grounding for the assistant (off by default) ----
# Whether a `web: true` request to /search/chat may also ground the answer in web results.
# Web hits come back as external citations; they never widen document access.
#   none   - web grounding unavailable (default)
#   stub   - deterministic canned results (dev/CI, no network)
#   tavily - live results (requires WEB_SEARCH_API_KEY). The only live provider implemented.
# The dashboard's Ask page shows a "Web" switch whichever value is set: while the provider is
# `none` the switch is accepted but grounds nothing, so turn one on before advertising it.
# WEB_SEARCH_PROVIDER=none
# WEB_SEARCH_API_KEY=
# Override the provider's API host (e.g. a self-hosted or proxied Tavily). Blank = the
# provider's own default (https://api.tavily.com).
# WEB_SEARCH_BASE_URL=
# How many web results are fetched per grounded answer.
# WEB_SEARCH_MAX_RESULTS=3

# ---- Secret scanning ----
# Scan ingested content for credentials (API keys, private keys, tokens). Flagged
# documents are QUARANTINED before indexing so an editor can review the (redacted)
# findings on the dashboard and approve or discard them. On by default; set to false
# only if you fully trust every ingestion source.
SECRET_SCAN_ENABLED=true

# ---- DLP / sensitivity scanning (extends the secret scanner) ----
# A second pass classifies ingested content as none | pii | confidential. On by default.
# DLP_DEFAULT_ACTION decides what a PII/confidential hit does:
#   label      - index normally and tag the document's sensitivity (default)
#   quarantine - park for review before indexing, like a secret hit
#   warn       - index and record the finding, no label change
# Labelled documents that are visible org-wide are listed on the admin-only Oversharing page.
DLP_ENABLED=true
DLP_DEFAULT_ACTION=label

# ---- Verified answers / content freshness ----
# Default review-by window applied when a document or answer is marked verified (the verify
# call can override it, or send 0 for no expiry). Verified content past its review date is
# flipped to `stale`.
# DEFAULT_REVIEW_INTERVAL_DAYS=180

# ---- Demo seed accounts ----
# `make seed` creates three demo logins (owner / editor / viewer). Each address is
# independently overridable; the defaults are the reserved example.com. Their shared
# password: leave DEMO_PASSWORD unset (the default) and the seeder GENERATES a random
# password and prints it once - there is no well-known demo credential anywhere. Set it
# only to pin a specific password (8-128 characters).
# Set these BEFORE creating the stack (`make up`) - containers capture their environment at
# creation, so after editing them run `make up` again, then `make seed`. Rotate an
# already-seeded demo (with the same emails it was seeded with) via
#   DEMO_PASSWORD=... python -m app.scripts.rotate_demo_password
# DEMO_ADMIN_EMAIL=
# DEMO_ENGINEER_EMAIL=
# DEMO_VIEWER_EMAIL=
# DEMO_PASSWORD=

# ---- Rate limiting ----
# Default per-API-key request budget per minute for newly minted keys (each key can override).
# DEFAULT_RATE_LIMIT_PER_MINUTE=120
# Per-user budget for dashboard (JWT session) callers. Several endpoints spend real provider
# tokens, so signed-in sessions are metered too - not just API keys.
# SESSION_RATE_LIMIT_PER_MINUTE=60

# ---- Self-serve signup ----
# Whether POST /auth/register is open. Unset means "enabled outside production": an instance
# holding real provider keys must opt in explicitly, because a brand-new org has no connector
# of its own, so a stranger who registers spends YOUR provider keys. Leave it closed on any
# instance reachable from the internet, and add people with invites instead.
# SIGNUP_ENABLED=false

# ---- Transactional email (org invites) ----
# Inviting a teammate (POST /api/v1/invites) is the only flow that sends mail, and the accept
# link is returned by no API and shown nowhere in the dashboard - so with the default `stub`
# provider (captured in-process, never sent) the invitee never receives it and the invite
# silently goes nowhere. `console` only logs that a message was addressed (recipient +
# subject); the body, which carries the single-use accept token, is deliberately never logged.
# `smtp` is therefore the only provider that actually delivers an invite: set
# EMAIL_PROVIDER=smtp and the SMTP_* settings before inviting anyone on a real deployment.
EMAIL_PROVIDER=stub                     # stub | console | smtp
EMAIL_FROM=Third Brain <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# How long a mailed invite link stays valid before the invitee has to be re-invited.
# INVITE_EXPIRE_HOURS=168

# ---- File storage for uploads ----
# Hard ceiling on any single request body, enforced before a handler buffers it (413 above
# it). Keep it at or above the 25 MiB document-upload cap, with headroom for multipart
# framing - lowering it below that silently shrinks the largest document anyone can upload.
# MAX_REQUEST_BODY_BYTES=33554432
STORAGE_BACKEND=local                   # local | s3
# /data/uploads is a Docker VOLUME path (mounted by docker-compose). When running the API
# OUTSIDE Docker, override this to a writable directory on the host, e.g.
#   STORAGE_LOCAL_PATH=./var/uploads     (or an absolute path you can write to)
# otherwise document ingestion fails because /data/uploads is not writable on the host.
STORAGE_LOCAL_PATH=/data/uploads
# For S3-compatible object storage (set STORAGE_BACKEND=s3):
S3_ENDPOINT_URL=
S3_BUCKET=third-brain
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# ---- Data-source connectors ----
# The reference `local_folder` connector reads raw files off the SERVER's filesystem. It is
# DISABLED by default (empty below). Only enable it on trusted, single-tenant deployments,
# and only for directories you intend org admins to be able to ingest - never leave it able
# to read the whole disk. Comma-separated absolute paths; a source's `root` must resolve to
# inside one of them.
#   LOCAL_CONNECTOR_ROOTS=/srv/knowledge,/data/shared
LOCAL_CONNECTOR_ROOTS=
# Gates on-demand syncs only: set to false and POST /data-sources/{id}/sync returns 403.
# The scheduled sweep (every 5 minutes, honouring each source's sync_interval_minutes) is
# NOT affected - pause or delete a source to stop it pulling.
# DATA_SOURCE_SYNC_ENABLED=true

# ---- Observability ----
# See docs/OBSERVABILITY.md. Logs are structured (structlog) and always on; tracing is
# OFF until you set an OTLP endpoint.
LOG_FORMAT=auto                         # auto | console | json (auto: console in dev, JSON in prod)
# OpenTelemetry OTLP endpoint (http/protobuf). Leave blank to disable tracing entirely.
# Local LGTM backend (`make up-obs`): http://lgtm:4318 when the API runs inside compose,
# http://localhost:4318 when the API runs on the host. Works with any OTLP backend
# (Grafana Cloud, Langfuse, Jaeger, Tempo, ...).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated key=value pairs attached to every export, e.g. for Langfuse or
# Grafana Cloud: OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64>
OTEL_EXPORTER_OTLP_HEADERS=
# Optional service.name override (defaults to third-brain-api / third-brain-worker).
OTEL_SERVICE_NAME=
OTEL_TRACES_SAMPLE_RATIO=1.0            # fraction of new traces sampled (lower under load)

# ---- Frontend (Next.js) ----
# Browser-facing API origin, BAKED into the web bundle at BUILD time (rebuild after changing
# it). Localhost for dev; for a deployment behind a domain set it to the public API origin,
# e.g. NEXT_PUBLIC_API_URL=https://api.your-domain.example
NEXT_PUBLIC_API_URL=http://localhost:8000
# SEO canonical / OpenGraph base URL for the marketing pages, also baked at BUILD time.
# Set it to the origin the dashboard is served from, e.g. https://your-domain.example
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Released container images (docker-compose.prod.yml) ----
# Container registry prefix for released images, e.g. ghcr.io/km322 (NO trailing slash).
# Leave unset to build the images locally.
IMAGE_REGISTRY=
# Released image tag to run, e.g. v1.0.0. Defaults to latest (the local build).
IMAGE_TAG=
# Uvicorn worker processes per API container (the image default is 4). Size it against the
# database pool budget - each process opens its own pool. See docs/DEPLOYMENT.md.
# UVICORN_WORKERS=4
# Cloudflare Tunnel connector token, read by docker-compose.cloudflare.yml. Only needed on
# the public-domain path (Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels); the
# single-box `make selfhost` overlay does not use it. See docs/SELF_HOSTING.md.
# CLOUDFLARE_TUNNEL_TOKEN=
